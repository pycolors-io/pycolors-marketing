# =====================================================
# PyColors Marketing — Environment variables example
# Copy this file to .env.local for local development.
# Real values must NEVER be committed.
# =====================================================

# Google Tag Manager ID
# Example: GTM-ABC1234
NEXT_PUBLIC_GTM_ID=

# PyColors API base URL
# Example: http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=

# Public Pro demo. Marketing defaults to this verified hosted deployment.
# Override at build time with an HTTPS origin or /demo URL (localhost HTTP for QA).
# Invalid non-empty values hide demo links and show the separate product tour.
# The Free starter keeps its own opt-in demo configuration.
NEXT_PUBLIC_STARTER_PRO_DEMO_URL=https://pro-demo.pycolors.io/demo
