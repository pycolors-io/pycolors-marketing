# =====================================================
# PyColors Marketing — Environment variables example
# Copy this file to .env.local for local development.
# Real values must NEVER be committed.
# =====================================================

# Google Tag Manager ID
# Example: GTM-ABC1234
NEXT_PUBLIC_GTM_ID=

# PyColors API base URL
# Example: http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=

# Enable only after verifying the isolated public Pro demo and buyer archive.
# HTTPS origin or /demo URL; leave blank until deployment is ready.
NEXT_PUBLIC_STARTER_PRO_DEMO_URL=
